--- /dev/null
+++ b/tools/club_badge_schema_test.cpp
@@ -0,0 +1,56 @@
+// Check the FileDescriptorProto actually advertised by the server, not just generated headers.
+// Build: clang++ -std=c++17 tools/club_badge_schema_test.cpp $(pkg-config --cflags --libs protobuf) -o out/club_badge_schema_test.exe
+// Usage: out/club_badge_schema_test.exe descriptor.bin
+#include <google/protobuf/descriptor.h>
+#include <google/protobuf/descriptor.pb.h>
+#include <google/protobuf/dynamic_message.h>
+#include <fstream>
+#include <iostream>
+#include <memory>
+
+namespace gp = google::protobuf;
+int main(int argc, char** argv) {
+    if (argc != 2) {
+        std::cerr << "Usage: club_badge_schema_test descriptor.bin\n";
+        return 2;
+    }
+    std::ifstream input(argv[1], std::ios::binary);
+    gp::FileDescriptorProto file;
+    if (!input || !file.ParseFromIstream(&input)) {
+        std::cerr << "FAIL: cannot read FileDescriptorProto\n";
+        return 1;
+    }
+    gp::DescriptorPool pool;
+    if (!pool.BuildFile(file)) {
+        std::cerr << "FAIL: cannot build advertised descriptor\n";
+        return 1;
+    }
+    const auto* message = pool.FindMessageTypeByName("CreateBobRequest");
+    const auto* field = message ? message->FindFieldByName("objectType") : nullptr;
+    if (!field || field->number() != 5 || field->is_repeated() ||
+        field->cpp_type() != gp::FieldDescriptor::CPPTYPE_ENUM) {
+        std::cerr << "FAIL: CreateBobRequest.objectType must be singular enum field 5\n";
+        return 1;
+    }
+    gp::DynamicMessageFactory factory(&pool);
+    for (int number : {1, 5}) {
+        const auto* value = field->enum_type()->FindValueByNumber(number);
+        if (!value) {
+            std::cerr << "FAIL: " << field->enum_type()->full_name()
+                      << " lacks value " << number
+                      << "; game 1.28 would pass NULL to Reflection::SetEnum\n";
+            return 1;
+        }
+        std::unique_ptr<gp::Message> request(factory.GetPrototype(message)->New());
+        request->GetReflection()->SetEnum(request.get(), field, value);
+        const std::string wire = request->SerializeAsString();
+        const std::string expected{char(0x28), char(number)};
+        if (wire != expected || !request->ParseFromString(wire) ||
+            request->GetReflection()->GetEnumValue(*request, field) != number) {
+            std::cerr << "FAIL: enum wire value changed\n";
+            return 1;
+        }
+        std::cout << "PASS: " << value->full_name() << "=" << number
+                  << " resolves and round-trips as field 5\n";
+    }
+}
diff --git a/tools/test_club_badge_server.py b/tools/test_club_badge_server.py
new file mode 100644
--- /dev/null
+++ b/tools/test_club_badge_server.py
@@ -0,0 +1,242 @@
+"""Start an isolated server and check its advertised badge enum and PNG uploads.
+
+Python standard library only. No requests go to an existing server. The work
+directory is always newly created, with an absolute database path, loopback
+listeners, no public listing, and UPnP disabled. Does not launch the game.
+"""
+import argparse
+import base64
+from contextlib import contextmanager
+import hashlib
+import hmac
+import json
+import os
+from pathlib import Path
+import socket
+import sqlite3
+import struct
+import subprocess
+import tempfile
+import time
+import urllib.request
+import zlib
+
+
+def varint(n):
+    out = bytearray()
+    while n >= 128:
+        out.append((n & 127) | 128)
+        n >>= 7
+    out.append(n)
+    return bytes(out)
+
+
+def field(number, value):
+    if isinstance(value, int):
+        return varint(number << 3) + varint(value)
+    if isinstance(value, str):
+        value = value.encode()
+    return varint((number << 3) | 2) + varint(len(value)) + value
+
+
+def fields(data):
+    pos = 0
+
+    def read_varint():
+        nonlocal pos
+        value = 0
+        for shift in range(0, 70, 7):
+            byte = data[pos]
+            pos += 1
+            value |= (byte & 127) << shift
+            if byte < 128:
+                return value
+        raise ValueError("oversized varint")
+
+    result = {}
+    while pos < len(data):
+        tag = read_varint()
+        wire = tag & 7
+        if wire == 0:
+            value = read_varint()
+        elif wire == 2:
+            size = read_varint()
+            value = data[pos:pos + size]
+            pos += size
+            if len(value) != size:
+                raise ValueError("truncated field")
+        else:
+            raise ValueError(f"unexpected wire type {wire}")
+        result[tag >> 3] = value
+    return result
+
+
+def png(size, variant):
+    def chunk(kind, data):
+        return (struct.pack(">I", len(data)) + kind + data +
+                struct.pack(">I", zlib.crc32(kind + data)))
+    rows = b"".join(b"\0" + bytes((x + variant) % 256 for x in range(size * 4))
+                    for _ in range(size))
+    return (b"\x89PNG\r\n\x1a\n" +
+            chunk(b"IHDR", struct.pack(">IIBBBBB", size, size, 8, 6, 0, 0, 0)) +
+            chunk(b"IDAT", zlib.compress(rows)) + chunk(b"IEND", b""))
+
+
+def free_port():
+    with socket.socket() as sock:
+        sock.bind(("127.0.0.1", 0))
+        return sock.getsockname()[1]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--server", required=True, type=Path)
+    parser.add_argument("--schema-check", required=True, type=Path)
+    parser.add_argument("--msys2", type=Path, default=Path("C:/msys64"))
+    parser.add_argument("--work-root", type=Path, default=Path("out/badge-investigation"))
+    args = parser.parse_args()
+    server, checker = args.server.resolve(strict=True), args.schema_check.resolve(strict=True)
+    args.work_root.mkdir(parents=True, exist_ok=True)
+    work = Path(tempfile.mkdtemp(prefix="server-test-", dir=args.work_root.resolve()))
+    port, admin_port = free_port(), free_port()
+    while admin_port == port:
+        admin_port = free_port()
+    config = {
+        "listen": {"address": "127.0.0.1", "port": port},
+        "admin": {"address": "127.0.0.1", "port": admin_port, "key": "badge-test-only"},
+        "database": {"file": str(work / "test.db")},
+        "log": {"file": str(work / "server.log"), "trace": True},
+        "shadnet": {"url": "", "allow_unverified": True},
+        "internet": {"upnp": False},
+        "server": {"list_on": "", "name": ""},
+    }
+    (work / "config.json").write_text(json.dumps(config), encoding="utf-8")
+    env = os.environ.copy()
+    env["PATH"] = str(args.msys2 / "clang64/bin") + os.pathsep + env.get("PATH", "")
+    env["QT_PLUGIN_PATH"] = str(args.msys2 / "clang64/share/qt6/plugins")
+    base = f"http://127.0.0.1:{port}"
+    # Never use a user's proxy for the isolated loopback server.
+    http = urllib.request.build_opener(urllib.request.ProxyHandler({}))
+    key = b""
+
+    def request(service, method, body=b""):
+        signature = base64.b64encode(hmac.digest(
+            b"ca91f51f-a7f5-4b95-814a-5796cfff586c", method.encode() + key + body, "sha1"))
+        req = urllib.request.Request(base + f"/egs/binary/{service}/{method}", body,
+                                     {"Content-Type": "application/octet-stream",
+                                      "X-Request-Signature": signature.decode()})
+        with http.open(req, timeout=10) as response:
+            return response.read(), response.headers
+
+    print(f"Isolated test directory: {work}", flush=True)
+    @contextmanager
+    def running_server():
+        with (work / "console.log").open("ab") as log:
+            process = subprocess.Popen([str(server)], cwd=work, env=env, stdout=log,
+                                       stderr=subprocess.STDOUT,
+                                       creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
+            try:
+                for _ in range(100):
+                    if process.poll() is not None:
+                        raise RuntimeError(f"server exited: see {work / 'console.log'}")
+                    try:
+                        with socket.create_connection(("127.0.0.1", port), timeout=0.2):
+                            break
+                    except OSError:
+                        time.sleep(0.1)
+                else:
+                    raise RuntimeError("server did not listen within 10 seconds")
+                yield
+            finally:
+                if process.poll() is None:
+                    process.terminate()
+                process.wait(timeout=10)
+
+    def club_metadata(lookup_url=True):
+        reply, _ = request("clubService", "queryClubs",
+                           field(2, club_id) + field(3, field(1, 1)) +
+                           field(7, 1) + field(9, int(lookup_url)))
+        return fields(fields(fields(reply)[1])[9])
+
+    def persisted_ids():
+        with sqlite3.connect(work / "test.db") as conn:
+            row = conn.execute("SELECT customization FROM clubs WHERE id = ?", (club_id,)).fetchone()
+        metadata = json.loads(row[0])
+        return metadata.get("badgeBobId"), metadata.get("smallBadgeBobId")
+
+    def verify_badge(metadata):
+        assert (metadata.get(7), metadata.get(8)) == (full_id, small_id), metadata
+        for url_field, bob_id in ((3, full_id), (4, small_id)):
+            url = metadata[url_field].decode()
+            assert url == f"{base}/ghosts/{bob_id}", url
+            with http.open(url, timeout=10) as response:
+                assert response.read() == expected_images[bob_id]
+
+    with running_server():
+        descriptor, _ = request("indexService", "getMessageDescriptors")
+        descriptor_file = work / "advertised-descriptor.bin"
+        descriptor_file.write_bytes(descriptor)
+        subprocess.run([str(checker), str(descriptor_file)], env=env, check=True)
+        login, headers = request("sessionService", "oauthLogin",
+                                 field(1, "badge-test") + field(7, "BadgeRegression"))
+        key = headers.get("X-SessionKey", "").encode()
+        if not key or not fields(login).get(1):
+            raise RuntimeError("no login session")
+        club, _ = request("clubService", "createAndJoin", field(2, "Badge Test Club"))
+        club_id = fields(club)[1]
+        assert not {3, 4, 7, 8} & club_metadata().keys()
+        assert persisted_ids() == (None, None)
+        uploaded_ids = []
+        expected_images = {}
+        for variant in (0, 1):
+            for size in (256, 64):
+                data = png(size, variant)
+                checksum = base64.b64encode(hashlib.md5(data).digest())
+                payload = (field(1, "image/png") + field(2, checksum) +
+                           field(3, len(data)) + field(4, data) +
+                           field(5, 5) + field(6, 0))
+                reply, _ = request("storageService", "createBob", payload)
+                result = fields(reply)
+                details = fields(result[2])
+                if not result[1] or details[1] != result[1] or details[3] != checksum:
+                    raise RuntimeError("bad upload ID or checksum")
+                url = details[2].decode()
+                if not url.startswith(base + "/"):
+                    raise RuntimeError(f"unexpected remote download URL: {url}")
+                with http.open(url, timeout=10) as response:
+                    if response.read() != data:
+                        raise RuntimeError("PNG download differs from upload")
+                remote, _ = request("storageService", "getRemoteUrl", field(1, result[1]))
+                if fields(remote)[2] != details[2]:
+                    raise RuntimeError("getRemoteUrl differs from createBob")
+                uploaded_ids.append(result[1])
+                expected_images[result[1]] = data
+                print(f"PASS: {size}x{size} PNG variant {variant}, objectType=5, "
+                      f"upload/download/checksum/URL, id={result[1]}", flush=True)
+            full_id, small_id = uploaded_ids[-2:]
+            customization = field(1, club_id) + field(7, full_id) + field(8, small_id)
+            updated, _ = request("clubService", "updateCustomization",
+                                 field(1, 1) + field(2, customization))
+            verify_badge(fields(fields(updated)[1]))
+            verify_badge(club_metadata())
+            assert persisted_ids() == (full_id, small_id)
+            print(f"PASS: club update and query return both persisted badges {full_id}, {small_id}")
+        # A livery-only update must not discard the current badge.
+        request("clubService", "updateCustomization",
+                field(2, field(1, club_id) + field(2, "test-livery")))
+        assert persisted_ids() == (full_id, small_id)
+        if len(set(uploaded_ids)) != 4:
+            raise RuntimeError("uploads did not receive distinct IDs")
+
+    with running_server():
+        assert persisted_ids() == (full_id, small_id)
+        verify_badge(club_metadata())
+        metadata = club_metadata(lookup_url=False)
+        assert (metadata.get(7), metadata.get(8)) == (full_id, small_id)
+        assert not {3, 4} & metadata.keys()
+    print("PASS: latest full-size and small badges persist across server restart.")
+
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/check_club_badge_pixels.py b/tools/check_club_badge_pixels.py
new file mode 100644
--- /dev/null
+++ b/tools/check_club_badge_pixels.py
@@ -0,0 +1,97 @@
+"""Compare actual Club Badge uploads, SQLite blobs and HTTP downloads."""
+
+import argparse
+import base64
+import hashlib
+import io
+import json
+from pathlib import Path
+import re
+import sqlite3
+import urllib.request
+
+from PIL import Image
+
+from test_club_badge_server import fields
+
+
+def upload_hashes(log):
+    requests = {}
+    hashes = set()
+    checksums = set()
+    for line in log.read_text(encoding="utf-8", errors="replace").splitlines():
+        start = re.search(r"trace: #(\d+) >>> (.*)", line)
+        if start:
+            number, route = start.groups()
+            requests.pop(number, None)
+            if "POST /egs/binary/storageService/createBob " in route:
+                requests[number] = bytearray()
+        checksum = re.search(r'trace: #(\d+) +~ +checksum: "([^"]+)"', line)
+        if checksum and checksum[1] in requests:
+            checksums.add(checksum[2])
+        chunk = re.search(r"trace: #(\d+) +\| ([a-fA-F0-9]{6})  ([a-fA-F0-9 ]+?)  ", line)
+        if chunk and chunk[1] in requests:
+            body = requests[chunk[1]]
+            if int(chunk[2], 16) == len(body):
+                body.extend(bytes.fromhex(chunk[3]))
+        end = re.search(r"trace: #(\d+) <<<", line)
+        if end and end[1] in requests:
+            try:
+                upload = fields(requests.pop(end[1]))
+                if upload.get(5) == 5 and len(upload[4]) == upload[3]:
+                    hashes.add(hashlib.sha256(upload[4]).hexdigest())
+            except (IndexError, KeyError, ValueError):
+                # Large bodies may be truncated. The upload's MD5 is still logged.
+                continue
+    return hashes, checksums
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--test-root", type=Path, default=Path("out/club-badge-game-test"))
+    parser.add_argument("--club", type=int, default=1)
+    parser.add_argument("--ids", type=int, nargs=2, help="Override the saved full and small IDs")
+    parser.add_argument("--client-log", type=Path, help="stderr log from BB_BADGE_PIXELS=1")
+    args = parser.parse_args()
+    root = args.test_root
+    hashes, checksums = upload_hashes(root / "logs/server.log")
+    encoded = (args.client_log.read_text(encoding="utf-8", errors="replace")
+               if args.client_log else None)
+    http = urllib.request.build_opener(urllib.request.ProxyHandler({}))
+    failed = False
+    db = (root / "server/driveclub.db").resolve()
+    with sqlite3.connect(db.as_uri() + "?mode=ro", uri=True) as conn:
+        ids = args.ids
+        if not ids:
+            row = conn.execute("SELECT customization FROM clubs WHERE id = ?", (args.club,)).fetchone()
+            metadata = json.loads(row[0])
+            ids = [metadata["badgeBobId"], metadata["smallBadgeBobId"]]
+        for bob_id, size in zip(ids, (256, 64), strict=True):
+            stored, stored_checksum = conn.execute(
+                "SELECT data, checksum FROM ghosts WHERE id = ?", (bob_id,)
+            ).fetchone()
+            with http.open(f"http://127.0.0.1:18080/ghosts/{bob_id}", timeout=10) as response:
+                downloaded = response.read()
+            digest = hashlib.sha256(stored).hexdigest()
+            md5 = base64.b64encode(hashlib.md5(stored).digest()).decode()
+            upload_match = "body SHA-256" if digest in hashes else (
+                "request MD5" if md5 == stored_checksum and md5 in checksums else "none"
+            )
+            same_bytes = downloaded == stored and upload_match != "none"
+            if encoded is not None:
+                same_bytes &= f"BADGE_PIXELS encoded {size}x{size} sha256={digest}" in encoded
+            with Image.open(io.BytesIO(downloaded), formats=["PNG"]) as png:
+                png.verify()
+            with Image.open(io.BytesIO(downloaded), formats=["PNG"]) as png:
+                if png.size != (size, size) or png.mode != "RGBA":
+                    raise ValueError(f"BOB {bob_id}: unexpected PNG size or mode")
+                alpha = png.getchannel("A").histogram()
+            visible = sum(alpha[1:])
+            print(f"BOB {bob_id} {size}x{size}: {len(downloaded)} bytes, {visible} visible pixels, "
+                  f"upload/storage/download match={same_bytes} ({upload_match}), sha256={digest}")
+            failed |= not same_bytes or not visible
+    raise SystemExit(int(failed))
+
+
+if __name__ == "__main__":
+    main()
